index ec48e40..c12b12e 100644
--- a/src/contourmark/geometry.py
+++ b/src/contourmark/geometry.py
@@ -27,6 +27,38 @@ class GeometryError(ValueError):
     pass
 
 
+class UnsupportedSVGError(GeometryError):
+    """The geometric detector cannot interpret this document's appearance."""
+
+
+def require_supported_effects(root: ET.Element) -> None:
+    """Reject appearance features that can hide or replace scored geometry.
+
+    This is a conservative gate, not a renderer or an occlusion proof. Keep
+    raw geometry parsing available for analysis, but call this before marking
+    or scoring. Unsupported must not be interpreted as an unmarked document.
+    """
+    unsupported = {"style", "script", "text", "image", "foreignObject",
+                   "animate", "animateTransform", "animateMotion", "set"}
+    for element in root.iter():
+        name = tag(element)
+        if name in unsupported or (name == "svg" and element is not root):
+            raise UnsupportedSVGError(f"unsupported SVG appearance element: {name}")
+        if name == "use":
+            raise UnsupportedSVGError("unsupported SVG appearance element: use (resolve instances first)")
+        declarations = dict(element.attrib)
+        for part in element.get("style", "").split(";"):
+            if ":" in part:
+                prop, value = part.split(":", 1)
+                declarations[prop.strip().lower()] = value.strip()
+        for prop in ("clip-path", "mask", "filter"):
+            value = declarations.get(prop, "none").strip().lower()
+            if value != "none":
+                raise UnsupportedSVGError(f"unsupported SVG appearance property: {prop}")
+        if any("var(" in value.lower() for value in declarations.values()):
+            raise UnsupportedSVGError("unsupported SVG CSS variable")
+
+
 SVG_NS = "http://www.w3.org/2000/svg"
 XLINK_NS = "http://www.w3.org/1999/xlink"
 _NUMBER = r"[-+]?(?:\d+\.?\d*|\.\d+)(?:[eE][-+]?\d+)?"
